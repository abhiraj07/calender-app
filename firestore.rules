rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidYearMonth(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidStatus(val) {
      return val is string && (val == 'available' || val == 'pending' || val == 'booked');
    }

    // --- VALIDATION HELPERS ---
    function isValidCalendarDate(data) {
      return isValidDateKey(data.dateKey) &&
             isValidYearMonth(data.yearMonth) &&
             data.yearMonth == data.dateKey[0:7] &&
             isValidStatus(data.status) &&
             data.isPublic is bool &&
             data.isPublic == true &&
             data.updatedByUid is string &&
             data.updatedByUid.size() >= 1 &&
             data.updatedByUid.size() <= 128 &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidAdminBooking(data) {
      return isValidDateKey(data.dateKey) &&
             isValidStatus(data.status) &&
             data.clientName is string && data.clientName.size() <= 100 &&
             data.clientPhone is string && data.clientPhone.size() <= 30 &&
             data.eventType is string && data.eventType.size() <= 60 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.updatedByUid is string &&
             data.updatedByUid.size() >= 1 &&
             data.updatedByUid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // --- COLLECTION RULES ---

    // 1. Public Calendar Availability (non-PII: dateKey, yearMonth, status)
    match /calendar_dates/{dateKey} {
      allow get: if isSignedIn() && isValidId(dateKey);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isAdmin() &&
                       isValidId(dateKey) &&
                       incoming().keys().hasAll(['dateKey', 'yearMonth', 'status', 'isPublic', 'updatedByUid', 'updatedAt']) &&
                       incoming().keys().hasOnly(['dateKey', 'yearMonth', 'status', 'isPublic', 'updatedByUid', 'updatedAt']) &&
                       incoming().dateKey == dateKey &&
                       incoming().updatedByUid == request.auth.uid &&
                       isValidCalendarDate(incoming());

      allow update: if isAdmin() &&
                       isValidId(dateKey) &&
                       isValidCalendarDate(incoming()) &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().yearMonth == existing().yearMonth &&
                       incoming().isPublic == existing().isPublic &&
                       incoming().updatedByUid == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedByUid', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(dateKey);
    }

    // 2. Private Admin Booking Details (PII isolated strictly to verified Admins)
    match /admin_bookings/{dateKey} {
      allow get: if isAdmin() && isValidId(dateKey);
      allow list: if isAdmin() && resource.data.dateKey is string;

      allow create: if isAdmin() &&
                       isValidId(dateKey) &&
                       incoming().keys().hasAll(['dateKey', 'status', 'clientName', 'clientPhone', 'eventType', 'notes', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['dateKey', 'status', 'clientName', 'clientPhone', 'eventType', 'notes', 'updatedByUid', 'createdAt', 'updatedAt']) &&
                       incoming().dateKey == dateKey &&
                       incoming().updatedByUid == request.auth.uid &&
                       isValidAdminBooking(incoming());

      allow update: if isAdmin() &&
                       isValidId(dateKey) &&
                       isValidAdminBooking(incoming()) &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedByUid == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'clientName', 'clientPhone', 'eventType', 'notes', 'updatedByUid', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(dateKey);
    }

    // 3. Admin Registry (prevents self-escalation)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
  }
}
